CAM_RE = re.compile(r"_(?P<h>\d+d\d+)_(?P<a>\d+)(?:_(?P<p>\d+w))?_", re.I)
BASE_BBOX_SCHEMA = [
    "bbox_h_norm",
    "bbox_w_norm",
    "bbox_y1_norm_neg",
    "bbox_y2_norm",
    "bbox_cy_norm",
    "area_norm",
    "rect_score",
]
AGG_NAMES = ["mean", "median", "p75", "p90", "std"]
CROP_SHAPE = (1, 128, 64)
DEFAULT_TEST_CAMERAS = [
    "2d5_0", "2d5_150", "2d5_30", "2d5_330", "2d5_90",
    "3d5_0", "3d5_150", "3d5_30", "3d5_330", "3d5_90",
